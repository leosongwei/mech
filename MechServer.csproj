<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The product version.  This file is the single source of truth: the web
         client's build reads it and stamps it under the lobby's subtitle
         (`frontend/webpack.config.js`), and the server logs it at boot.  Every
         change to the product bumps it: a feature change the SECOND number (the
         third going back to 0), a change a player cannot see the THIRD. -->
    <Version>1.14.0</Version>
    <AssemblyName>MechServer</AssemblyName>
    <RootNamespace>Mech.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

</Project>
